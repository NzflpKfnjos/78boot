+static void ksu_stage_bootstrap(void)
+{
+    struct file *file;
+    struct inode_security_struct *security;
+    const struct cred *saved;
+    loff_t offset = 0;
+    ssize_t written;
+
+    if (!ksu_file_sid) {
+        pr_err("root-control: no private file SID; preparation disabled\n");
+        return;
+    }
+    saved = override_creds(ksu_cred);
+    file = filp_open("/dev/root-control-boot", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0500);
+    if (IS_ERR(file)) {
+        revert_creds(saved);
+        pr_err("root-control: cannot stage signed bootstrap: %ld\n", PTR_ERR(file));
+        return;
+    }
+    security = selinux_inode(file_inode(file));
+    if (security)
+        security->sid = ksu_file_sid;
+    written = kernel_write(file, root_bootstrap_blob, sizeof(root_bootstrap_blob), &offset);
+    filp_close(file, NULL);
+    revert_creds(saved);
+    if (written != (ssize_t)sizeof(root_bootstrap_blob))
+        pr_err("root-control: incomplete bootstrap write: %zd\n", written);
+    else
+        pr_info("root-control: signed embedded bootstrap prepared\n");
+}
